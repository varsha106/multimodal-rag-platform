# Local defaults. No cloud credentials are required.
RAG_DATA_DIR=data/sample_docs
RAG_EMBEDDER=auto
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER=lexical
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140
RAG_CANDIDATE_K=24
RAG_TOP_K=5
